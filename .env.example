# SAMADHAN Environment Configuration Example
# Copy this file to .env and fill in the values for local development.

# Application Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174


# Database (MySQL 8.0)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=samadhan_db

# Security & Authentication
JWT_SECRET=replace_with_a_long_secure_random_string_min_32_chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# Operational Defaults
SLA_WARNING_DAYS=20
SLA_OVERDUE_DAYS=30
MATCH_SIMILARITY_THRESHOLD=0.65
